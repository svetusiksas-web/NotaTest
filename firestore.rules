rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'svetusiksas@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /tests/{testId} {
      allow read: if resource.data.status == 'published' || (isTeacher() && request.auth.uid == resource.data.ownerId);
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTeacher() && request.auth.uid == resource.data.ownerId;
    }
    match /attempts/{attemptId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.ownerId
        && get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.status == 'published';
      allow read: if isTeacher() && request.auth.uid == resource.data.ownerId;
      allow update, delete: if false;
    }
  }
}
